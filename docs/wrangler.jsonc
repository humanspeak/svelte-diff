/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "svelte-page-diff",
    "compatibility_date": "2026-07-17",
    "compatibility_flags": ["nodejs_compat"],
    "main": ".svelte-kit/cloudflare/_worker.js",
    "assets": {
        "directory": ".svelte-kit/cloudflare",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    },
    "upload_source_maps": true,
    "vars": {
        "PUBLIC_ENVIRONMENT": "production",
        // checkov:skip=CKV_SECRET_6: PostHog project tokens are public client-side SDK identifiers.
        "PUBLIC_POSTHOG_PROJECT_TOKEN": "phc_mDsPXhtJkSHtm3MXXmSoMzJ4ZGtJvm8PXdFgi7qRAVhh",
        "PUBLIC_POSTHOG_HOST": "https://j.svelte.page",
        "ENVIRONMENT": "production",
        "NODE_ENV": "production"
    }
}
